{{>header}}

<title>CRUD | Employee Details</title>

</head>

{{>navbar}}

<div class="container my-4 px-3 px-md-4">

    <!-- Page Header -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">

        <div>
            <h3 class="fw-bold mb-1">Employee Details</h3>

            <p class="text-muted mb-0">
                View complete employee information
            </p>
        </div>

        <div class="d-flex gap-2">

            <a href="/" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left"></i>
                Back
            </a>

            <a href="/edit/{{data._id}}" class="btn btn-primary">
                <i class="bi bi-pencil"></i>
                Edit Employee
            </a>

        </div>

    </div>


    <!-- Employee Details Card -->
    <div class="card border-0 shadow-sm">

        <!-- Header -->
        <div class="card-header text-white py-3" style="background-color: #1e293b;">

            <div class="d-flex align-items-center gap-3">

                <div class="bg-white text-primary rounded-circle d-flex align-items-center justify-content-center"
                    style="width: 50px; height: 50px;">

                    <i class="bi bi-person-fill fs-4"></i>

                </div>

                <div>

                    <h5 class="mb-1">
                        {{data.name}}
                    </h5>

                    <small class="text-white-50">
                        Employee Information
                    </small>

                </div>

            </div>

        </div>


        <!-- Details -->
        <div class="card-body p-4">

            <div class="row g-4">

                <!-- Name -->
                <div class="col-md-6">

                    <div class="border rounded p-3 h-100">

                        <small class="text-muted d-block mb-1">
                            <i class="bi bi-person me-1"></i>
                            Full Name
                        </small>

                        <div class="fw-semibold">
                            {{data.name}}
                        </div>

                    </div>

                </div>


                <!-- Email -->
                <div class="col-md-6">

                    <div class="border rounded p-3 h-100">

                        <small class="text-muted d-block mb-1">
                            <i class="bi bi-envelope me-1"></i>
                            Email Address
                        </small>

                        <div class="fw-semibold">
                            {{data.email}}
                        </div>

                    </div>

                </div>


                <!-- Phone -->
                <div class="col-md-6">

                    <div class="border rounded p-3 h-100">

                        <small class="text-muted d-block mb-1">
                            <i class="bi bi-telephone me-1"></i>
                            Phone Number
                        </small>

                        <div class="fw-semibold">
                            {{data.phone}}
                        </div>

                    </div>

                </div>


                <!-- Designation -->
                <div class="col-md-6">

                    <div class="border rounded p-3 h-100">

                        <small class="text-muted d-block mb-1">
                            <i class="bi bi-briefcase me-1"></i>
                            Designation
                        </small>

                        <div>
                            <span class="badge bg-primary">
                                {{data.designation}}
                            </span>
                        </div>

                    </div>

                </div>


                <!-- Salary -->
                <div class="col-md-6">

                    <div class="border rounded p-3 h-100">

                        <small class="text-muted d-block mb-1">
                            <i class="bi bi-currency-rupee me-1"></i>
                            Salary
                        </small>

                        <div class="fw-semibold">
                            ₹{{data.salary}}
                        </div>

                    </div>

                </div>


                <!-- City -->
                <div class="col-md-6">

                    <div class="border rounded p-3 h-100">

                        <small class="text-muted d-block mb-1">
                            <i class="bi bi-geo-alt me-1"></i>
                            City
                        </small>

                        <div class="fw-semibold">

                            {{#if data.city}}
                            {{data.city}}
                            {{else}}
                            <span class="text-muted">
                                Not provided
                            </span>
                            {{/if}}

                        </div>

                    </div>

                </div>


                <!-- State -->
                <div class="col-md-6">

                    <div class="border rounded p-3 h-100">

                        <small class="text-muted d-block mb-1">
                            <i class="bi bi-map me-1"></i>
                            State
                        </small>

                        <div class="fw-semibold">

                            {{#if data.state}}
                            {{data.state}}
                            {{else}}
                            <span class="text-muted">
                                Not provided
                            </span>
                            {{/if}}

                        </div>

                    </div>

                </div>


                <!-- Employee ID -->
                <div class="col-md-6">

                    <div class="border rounded p-3 h-100">

                        <small class="text-muted d-block mb-1">
                            <i class="bi bi-fingerprint me-1"></i>
                            Employee ID
                        </small>

                        <div class="fw-semibold">
                            {{displayEmployeeId}}
                        </div>
                    </div>

                </div>

            </div>

        </div>

    </div>

</div>

{{>footer}}