    <!-- Floating AI Assistant -->
    <div class="ai-assistant-floating">

        <!-- Orbiting Icons -->
        <div class="ai-orbit">

            <span class="ai-orbit-icon icon-1">
                <i class="bi bi-chat-dots-fill"></i>
            </span>

            <span class="ai-orbit-icon icon-2">
                <i class="bi bi-stars"></i>
            </span>

            <span class="ai-orbit-icon icon-3">
                <i class="bi bi-bar-chart-fill"></i>
            </span>

            <span class="ai-orbit-icon icon-4">
                <i class="bi bi-lightbulb-fill"></i>
            </span>

        </div>

        <!-- Main AI Button -->
        <a href="/ai" class="ai-main-button" title="Ask AI Assistant">

            <i class="bi bi-robot"></i>

        </a>

        <!-- Tooltip -->
