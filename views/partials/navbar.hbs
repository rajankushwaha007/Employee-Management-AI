            Ask AI Assistant
        </div>

    </div>


    <style>
        /* Main Floating Container */
        .ai-assistant-floating {
            position: fixed;
            left: 28px;
            bottom: 28px;

            width: 90px;
            height: 90px;

            z-index: 9999;
        }


        /* Main AI Button */
        .ai-main-button {
            position: absolute;

            width: 64px;
            height: 64px;

            left: 13px;
            top: 13px;

            border-radius: 50%;

            background: linear-gradient(135deg,
                    #2563eb,
                    #1d4ed8);

            color: white;

            display: flex;
            align-items: center;
            justify-content: center;

            font-size: 30px;

            text-decoration: none;

            box-shadow:
                0 0 15px rgba(37, 99, 235, 0.6),
                0 0 35px rgba(37, 99, 235, 0.35);

            z-index: 10;

            transition: 0.3s ease;
        }


        /* Hover */
        .ai-main-button:hover {
            color: white;

            transform: scale(1.08);

            box-shadow:
                0 0 20px rgba(37, 99, 235, 0.8),
                0 0 45px rgba(37, 99, 235, 0.5);
        }


        /* Orbit Circle */
        .ai-orbit {
            position: absolute;

            width: 90px;
            height: 90px;

            left: 0;
            top: 0;

            border: 2px solid rgba(37, 99, 235, 0.25);

            border-radius: 50%;

            animation: aiRotate 8s linear infinite;
        }


        /* Orbit Icons */
        .ai-orbit-icon {
            position: absolute;

            width: 28px;
            height: 28px;

            border-radius: 50%;

            display: flex;
            align-items: center;
            justify-content: center;

            color: white;

            font-size: 13px;

            box-shadow: 0 3px 10px rgba(0, 0, 0, 0.25);
        }


        /* Icon Positions */
        .icon-1 {
            top: -14px;
            left: 31px;
            background: #10b981;
        }

        .icon-2 {
            right: -14px;
            top: 31px;
            background: #f59e0b;
        }

        .icon-3 {
            bottom: -14px;
            left: 31px;
            background: #ec4899;
        }

        .icon-4 {
            left: -14px;
            top: 31px;
            background: #8b5cf6;
        }


        /* Rotation */
        @keyframes aiRotate {

            from {
                transform: rotate(0deg);
            }

            to {
                transform: rotate(360deg);
            }

        }


        /* Tooltip */
        .ai-tooltip {
            position: absolute;

            right: 5px;
            bottom: 98px;

            background: #172554;
            color: white;

            padding: 8px 13px;

            border-radius: 8px;

            font-size: 13px;
            font-weight: 600;

            white-space: nowrap;

            opacity: 0;

            transform: translateY(5px);

            pointer-events: none;

            transition: 0.25s ease;
        }


        /* Show Tooltip */
        .ai-assistant-floating:hover .ai-tooltip {
            opacity: 1;
            transform: translateY(0);
        }


        /* Mobile */
        @media (max-width: 576px) {

            .ai-assistant-floating {
                left: 18px;
                bottom: 18px;
            }

        }

        body {
            background-color: #f8fafc;
            color: #212529;
            transition: background-color 0.3s ease, color 0.3s ease;
        }

        /* Dark Mode */
        body.dark-mode {
            background-color: #111827;
            color: #f1f5f9;
        }

        /* Cards */
        body.dark-mode .card {
            background-color: #1f2937;
            color: #f1f5f9;
            border-color: #374151;
        }

        /* Tables */
        body.dark-mode .table {
            color: #f1f5f9;
        }

        body.dark-mode .table-light {
            --bs-table-bg: #374151;
            --bs-table-color: #ffffff;
        }

        /* Forms */
        body.dark-mode .form-control,
        body.dark-mode .form-select {
            background-color: #1f2937;
            color: #f1f5f9;
            border-color: #4b5563;
        }

        body.dark-mode .form-control::placeholder {
            color: #9ca3af;
        }

        /* Modal */
        body.dark-mode .modal-content {
            background-color: #1f2937;
            color: #f1f5f9;
        }

        /* Text */
        body.dark-mode .text-dark {
            color: #f1f5f9 !important;
        }

        body.dark-mode .text-muted {
            color: #9ca3af !important;
        }
        #themeToggle:hover {
            transform: scale(1.08);
        }
        /* Crescent Moon */
        .moon-icon {
            width: 20px;
            height: 20px;

            border-radius: 50%;

            background: #2563eb;

            display: block;

            position: relative;
        }

        /* Cut the right side of moon */

        .moon-icon::after {
            content: "";

            position: absolute;

            width: 20px;
            height: 20px;

            border-radius: 50%;

            background: #ffffff;

            top: -5px;
            left: 6px;
        }
        /* Dark mode */
        body.dark-mode .moon-icon {
            background: #facc15;
        }
        body.dark-mode .moon-icon::after {
            background: #374151;
        }
    </style>
    <script>
        const themeToggle = document.getElementById("themeToggle");

        const savedTheme = localStorage.getItem("theme");

        if (savedTheme === "dark") {
            document.body.classList.add("dark-mode");
        }

        themeToggle.addEventListener("click", function () {

            document.body.classList.toggle("dark-mode");

            if (document.body.classList.contains("dark-mode")) {
                localStorage.setItem("theme", "dark");
            } else {
                localStorage.setItem("theme", "light");
            }

        });
    </script>